[libos]
entrypoint = "/tee_server"

# Generate with:
# gramine-manifest -Darch_libdir=/lib/x86_64-linux-gnu -Dtieredomap_root=$PWD tee_server.manifest.template tee_server.manifest

[loader]
log_level = "error"
argv = ["/tee_server", "--min_logN", "14", "--max_logN", "22", "--n", "1024", "--val", "256", "--port", "12345"]

[loader.env]
LD_LIBRARY_PATH = "/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/lib"
uri = "file:{{ gramine.runtimedir() }}"

[[fs.mounts]]
path = "/lib/x86_64-linux-gnu"
uri = "file:/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/usr/lib/x86_64-linux-gnu"
uri = "file:/usr/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/tee_server"
uri = "file:{{ tieredomap_root }}/build/tee_server"

[[fs.mounts]]
path = "/etc"
uri = "file:/etc"

[sgx]
enclave_size = "64G"
max_threads = 4
debug = false
edmm_enable = false
trusted_files = [
    "file:{{ tieredomap_root }}/build/tee_server",
    "file:{{ gramine.libos }}",
    "file:{{ gramine.runtimedir() }}/",
    "file:/lib/x86_64-linux-gnu/libcrypto.so.3",
    "file:/lib/x86_64-linux-gnu/libstdc++.so.6",
    "file:/lib/x86_64-linux-gnu/libm.so.6",
    "file:/lib/x86_64-linux-gnu/libgcc_s.so.1",
    "file:/lib/x86_64-linux-gnu/libc.so.6",
    "file:/lib64/ld-linux-x86-64.so.2",
]

[sys]
insecure__allow_eventfd = true
enable_sigterm_injection = true
