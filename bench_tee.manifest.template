[libos]
entrypoint = "/bench_tee"

[loader]
log_level = "error"
argv = ["/bench_tee", "--max_logN", "24", "--n", "1024", "--val", "256", "--Q", "200", "--s", "0.99", "--outdir", "/root/TieredOMap/tee_results_sgx"]

[loader.env]
LD_LIBRARY_PATH = "/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/lib"
uri = "file:{{ gramine.runtimedir() }}"

[[fs.mounts]]
path = "/lib/x86_64-linux-gnu"
uri = "file:/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/usr/lib/x86_64-linux-gnu"
uri = "file:/usr/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/bench_tee"
uri = "file:/root/TieredOMap/build/bench_tee"

[[fs.mounts]]
path = "/root/TieredOMap/tee_results_sgx"
uri = "file:/root/TieredOMap/tee_results_sgx"
type = "chroot"

[[fs.mounts]]
path = "/etc"
uri = "file:/etc"

[[fs.mounts]]
path = "/tmp"
uri = "file:/tmp"
type = "chroot"

[sgx]
enclave_size = "32G"
max_threads = 4
debug = false
edmm_enable = true
allowed_files = [
    "file:/root/TieredOMap/tee_results_sgx/",
    "file:/tmp/",
]

[sys]
insecure__allow_eventfd = true
enable_sigterm_injection = true
